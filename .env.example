# Frontend: copy this file to frontend/.env.
# Set this to http://localhost:8000 to use the FastAPI backend.
# Leave empty to keep the clearly labelled local demo mode.
VITE_API_URL=

# Backend: copy backend/.env.example to backend/.env.
# These values are documented here only to show the project configuration boundary.
DATABASE_URL=postgresql+psycopg://baymax:change-me-local-only@localhost:5432/baymax
SESSION_SECRET=replace-with-a-long-random-secret
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
